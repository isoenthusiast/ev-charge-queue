<!doctype html>
<html lang="en">
  <head>
    @include('partials/head')
  </head>
  <body>
    <main class="login">
      <p class="eyebrow">CHARGE QUEUE</p>
      <h1>Welcome back.</h1>
      <p>Your next charge, without the guesswork.</p>
      @if(flashMessages.has('errorsBag'))
        <p role="alert">Unable to sign in. Check your email and password.</p>
      @end

      <form method="post" action="/login">
        {{ csrfField() }}
        <label>
          
          
          Email


          <input name="email" type="email" autocomplete="username" required />
        </label>
        <label>
          
          
          Password


          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Sign in</button>
      </form>
      <p class="muted">Accounts are created by your administrator.</p>
    </main>
  </body>
</html>
